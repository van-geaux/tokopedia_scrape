# Salin file ini sebagai .env, lalu isi nilai proxy jika diperlukan.
# Biarkan PROXY_HOST dan PROXY_PORT kosong untuk koneksi langsung.

PROXY_SCHEME=http
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Alternatif: isi URL proxy lengkap, dengan atau tanpa autentikasi.
# Jika diisi, PROXY_URL akan diprioritaskan daripada variabel di atas.
# Contoh: http://username:password@proxy.example.com:8080
PROXY_URL=
